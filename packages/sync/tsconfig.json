{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // This package's code runs in a browser (local-database.ts's OPFS/Worker/WASM, and now
    // connector.ts's `fetch`) despite being a workspace "package" — the base config's ES2022-only
    // lib has no DOM globals. Not DOM.Iterable: nothing here iterates a DOM collection.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"]
}
