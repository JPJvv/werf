# Werf — example environment. Run `pnpm setup:local` to create the ignored local `.env` and
# generate its secrets; this file documents the shape. NEVER commit `.env`.

# --- Postgres (local dev) ---
# The request path is the RLS-bound role; provisioning/migrations use the owner separately.
DATABASE_URL=postgres://werf_app:werf_app_dev@localhost:5432/werf
DATABASE_ELEVATED_URL=postgres://werf:werf@localhost:5432/werf
POSTGRES_USER=werf
POSTGRES_PASSWORD=werf
POSTGRES_DB=werf

# --- PowerSync (sync service) ---
POWERSYNC_URL=http://localhost:8080
# RS256 keypair the API signs PowerSync connection tokens with. `pnpm setup:local` writes the
# private key as one ignored base64 line and derives the public modulus for PowerSync. To rotate:
#   node scripts/generate-dev-powersync-key.mjs
POWERSYNC_JWT_PRIVATE_KEY=
POWERSYNC_JWT_PRIVATE_KEY_BASE64=
PS_JWKS_N=
POWERSYNC_JWT_KID=werf-dev-1
POWERSYNC_AUDIENCE=werf-dev

# --- API (NestJS) ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# PII encryption key — generate a strong random value, keep it out of the repo.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
# Access-token signing secret — 32+ bytes.
JWT_SECRET=

# --- Object storage (attachments, phase-checklists.md 3i) ---
# MinIO in dev/test (docker-compose.yml's `minio` service); real S3 in af-south-1 in production
# (ADR-0002 — no Supabase Cloud, no cross-region bucket). AttachmentsModule refuses to boot with
# OBJECT_STORAGE_BUCKET unset — there is no degraded no-op mode for a presigned upload.
OBJECT_STORAGE_BUCKET=werf-attachments-dev
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=af-south-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=werf-dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=werf-dev-secret

# --- Region (Terraform variable in infra; here for reference) ---
AWS_REGION=af-south-1
