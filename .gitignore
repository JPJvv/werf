# Secrets — never commit
.env
.env.*
!.env.example
*.pem
infra/secrets/

# Claude Code escape hatch (Stop-hook override)
.claude/gate-off

# Dependencies / build
node_modules/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# CI artifacts (gitleaks-action writes results.sarif into the workspace)
*.sarif

# Local databases / dumps
*.sqlite
*.sqlite-*
*.dump

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Playwright run artifacts — traces and error contexts, never committed.
test-results/
playwright-report/
