# Werf — example environment. Copy to .env and fill in. NEVER commit .env.
# .env is git-ignored and denied to Claude Code tooling (see .claude/settings.json).

# --- Postgres (local dev) ---
DATABASE_URL=postgres://werf:werf@localhost:5432/werf
POSTGRES_USER=werf
POSTGRES_PASSWORD=werf
POSTGRES_DB=werf

# --- PowerSync (sync service) ---
POWERSYNC_URL=http://localhost:8080
# RS256 keypair the API signs PowerSync connection tokens with; the PUBLIC half lives in
# infra/powersync/service.yaml's client_auth.jwks and must match. Regenerate both together:
#   node scripts/generate-dev-powersync-key.mjs
POWERSYNC_JWT_PRIVATE_KEY=
POWERSYNC_JWT_KID=werf-dev-1
POWERSYNC_AUDIENCE=werf-dev

# --- API (NestJS) ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# PII encryption key — generate a strong random value, keep it out of the repo.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
# Access-token signing secret — 32+ bytes.
JWT_SECRET=

# --- Region (Terraform variable in infra; here for reference) ---
AWS_REGION=af-south-1
